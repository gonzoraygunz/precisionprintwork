# Copy this file to .env.local and fill in real values

# Resend — https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_...

# Where quote request emails are sent (your inbox)
TO_EMAIL=michael@precisionprintwork.com

# The "from" address — must be a verified domain in Resend
FROM_EMAIL=quotes@precisionprintwork.com

# Vercel Blob — needed for quote attachments over 4 MB (up to 25 MB).
# Create a Blob store in the Vercel dashboard (Storage → Blob) and connect it to this
# project; Vercel then sets this automatically. Smaller files work without it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
